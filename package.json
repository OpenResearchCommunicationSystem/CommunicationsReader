{
  "name": "claude-email-analizer",
  "version": "1.0.0",
  "description": "Air-gapped, read-only viewer for .eml/.mbox email export archives. Core parsing module (Milestone 1).",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node src/parser/smoke-cli.js",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "start": "npm run build:renderer && electron .",
    "package": "npm run build:renderer && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fas": "^1.0.0",
    "adm-zip": "^0.5.18",
    "chardet": "^2.2.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.communicationsreader.app",
    "productName": "Communications Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "src/**",
      "dist/renderer/**",
      "package.json",
      "!**/*.test.js"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "CommunicationsReader-${version}-portable.exe"
    }
  }
}
