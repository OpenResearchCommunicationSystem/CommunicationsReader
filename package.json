{
  "name": "communications-reader",
  "version": "1.0.0",
  "buildNumber": 15,
  "description": "Air-gapped-first communications analysis tool for e-discovery and investigative research: import, search, thread, translate/OCR via an optional AI endpoint, and export a curated focus set.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test test/*.test.js",
    "smoke": "node src/parser/smoke-cli.js",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "start": "npm run build:renderer && electron .",
    "package": "node scripts/bump-build-number.mjs && npm run build:renderer && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@thednp/dommatrix": "^3.0.4",
    "adm-zip": "^0.6.1",
    "chardet": "^2.2.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "path2d": "^0.3.3",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.communicationsreader.app",
    "productName": "Communications Reader",
    "buildVersion": "1.0.0.15",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "src/**",
      "dist/renderer/**",
      "package.json",
      "!**/*.test.js"
    ],
    "win": {
      "target": "portable",
      "artifactName": "CommunicationsReader-${buildVersion}-portable.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
